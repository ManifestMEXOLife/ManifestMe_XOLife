# --- Dependencies ---
# (No leading slash = ignores node_modules in root AND inside apps/)
node_modules/
.pnp
.pnp.js

# --- Build Outputs ---
dist/
build/
out/
coverage/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Environment & Secrets (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# (Keep .env.example if you have one, these rules won't block it)

# --- System Files ---
.DS_Store
Thumbs.db

# --- Elastic Beanstalk ---
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml