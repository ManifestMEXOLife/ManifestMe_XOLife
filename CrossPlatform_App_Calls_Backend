const registerUser = async () => {
  const response = await fetch("http://127.0.0.1:8000/register", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({
      id: 1,
      name: "Dina",
      email: "dina@example.com"
    })
  });
  const data = await response.json();
  console.log(data);
};
