name: Deploy Application

on:
  push:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy to'
        required: true
        default: 'production'
        type: choice
        options:
          - production
          - staging
      skip_tests:
        description: 'Skip tests before deploy'
        required: false
        default: false
        type: boolean

concurrency:
  group: deploy-${{ github.ref }}-${{ inputs.environment || 'production' }}
  cancel-in-progress: false

env:
  NODE_VERSION: '22'
  AWS_REGION: ${{ secrets.AWS_REGION || 'us-east-1' }}

permissions:
  id-token: write
  contents: read

jobs:
  pre-deploy-checks:
    name: Pre-deployment Checks
    runs-on: ubuntu-latest
    if: ${{ !inputs.skip_tests }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - run: npm ci

      - name: Clean build artifacts
        run: |
          rm -rf dist coverage || true

      - name: Generate Prisma client
        run: npx prisma generate || true

      - run: npm run test:cjs -- --passWithNoTests

      - run: npm audit --audit-level=high

  build-and-deploy:
    name: Build & Deploy to ${{ inputs.environment || 'production' }}
    runs-on: ubuntu-latest
    needs: [pre-deploy-checks]
    if: always() && (needs.pre-deploy-checks.result == 'success' || inputs.skip_tests)
    environment: ${{ inputs.environment || 'production' }}
    outputs:
      deployment-url: ${{ steps.deploy.outputs.environment-url }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - run: npm ci
      - run: npm run build || npx tsc

      - name: Determine deploy credentials
        id: creds-check
        run: |
          ENV="${{ inputs.environment }}"
          creds=false
          ROLE=""
          ACCESS=""

          if [ "$ENV" = "production" ]; then
            if [ -n "${{ secrets.AWS_OIDC_ROLE_ARN }}" ]; then
              creds=true
              ROLE="${{ secrets.AWS_OIDC_ROLE_ARN }}"
            elif [ -n "${{ secrets.AWS_ACCESS_KEY_ID }}" ]; then
              creds=true
              ACCESS="${{ secrets.AWS_ACCESS_KEY_ID }}"
            fi
          else
            if [ -n "${{ secrets.AWS_OIDC_ROLE_ARN_STAGING }}" ]; then
              creds=true
              ROLE="${{ secrets.AWS_OIDC_ROLE_ARN_STAGING }}"
            elif [ -n "${{ secrets.AWS_ACCESS_KEY_ID }}" ]; then
              creds=true
              ACCESS="${{ secrets.AWS_ACCESS_KEY_ID }}"
            fi
          fi

          echo "credentials_present=$creds" >> $GITHUB_OUTPUT
          echo "role=$ROLE" >> $GITHUB_OUTPUT
          echo "access=$ACCESS" >> $GITHUB_OUTPUT

      - name: Configure AWS Credentials (OIDC)
        if: ${{ steps.creds-check.outputs.credentials_present == 'true' && steps.creds-check.outputs.role != '' }}
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ steps.creds-check.outputs.role }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Configure AWS Credentials (Static)
        if: ${{ steps.creds-check.outputs.credentials_present == 'true' && steps.creds-check.outputs.access != '' }}
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ steps.creds-check.outputs.access }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}
          role-session-name: GitHubActions-${{ github.run_id }}

      - name: Load secrets from AWS
        run: |
          if [ -f fetchSecret.safe.ts ]; then
            npx ts-node --files fetchSecret.safe.ts
          fi
        continue-on-error: true

      - uses: actions/setup-python@v4
        with:
          python-version: '3.11'
          cache: 'pip'

      - run: pip install awsebcli==3.21.14

      - name: Package application
        run: |
          if [ -d dist ]; then
            zip -r app-${{ github.sha }}.zip dist package.json package-lock.json prisma/ .ebextensions/ -x "*.git*" "node_modules/*" "*.log"
          else
            zip -r app-${{ github.sha }}.zip . -x "*.git*" "node_modules/*" "*.log" "dist/*" "src/*" "*.ts" "tsconfig.json"
          fi

      - name: Deploy to Elastic Beanstalk
        id: deploy
        run: |
          eb init ${{ secrets.EB_APP_NAME || 'manifestme-api' }} --region ${{ env.AWS_REGION }} --platform "Node.js 22 running on 64bit Amazon Linux 2023"
          eb deploy ${{ secrets.EB_ENV_NAME || 'manifestme-env' }} --staged --timeout 20
          echo "environment-url=$(eb status | grep CNAME | awk '{print $2}')" >> $GITHUB_OUTPUT

      - name: Health check
        run: |
          sleep 30
          curl -f ${{ steps.deploy.outputs.environment-url }}/health || exit 1

  notify:
    name: Notify Deployment Status
    runs-on: ubuntu-latest
    needs: [build-and-deploy]
    if: always()
    steps:
      - name: Notify success
        if: needs.build-and-deploy.result == 'success'
        run: echo "✅ Deployment successful to ${{ needs.build-and-deploy.outputs.deployment-url }}"

      - name: Notify failure
        if: needs.build-and-deploy.result == 'failure'
        run: |
          echo "❌ Deployment failed"
          exit 1
